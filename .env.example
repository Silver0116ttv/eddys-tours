# Without these public values the storefront uses its bundled catalog as a safe fallback.
# Copy this file to .env.local; never commit the populated file.

# Canonical public origin, used for metadata, robots.txt and the sitemap.
# Production: https://www.eddystourspv.com (must match the canonical host in next.config.mjs).
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to disable tracking.
NEXT_PUBLIC_GA_ID=

# Public Supabase configuration (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets (never prefix these with NEXT_PUBLIC_)
# Never expose this value to browser code. Reserve it for trusted checkout,
# Stripe webhook, and background inventory jobs.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe is added in P2.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
