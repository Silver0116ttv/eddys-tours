# Without these public values the storefront uses its bundled catalog as a safe fallback.
# Copy this file to .env.local; never commit the populated file.

# Public Supabase configuration (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets (never prefix these with NEXT_PUBLIC_)
# Not used by browser code. Reserve this for trusted route handlers and background jobs.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe is added in P2.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
